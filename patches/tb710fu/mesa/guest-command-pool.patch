+static size_t
+vn_command_shmem_pool_min_size(void)
+{
+   /* Target-profile opt-in. Preserve stock behavior outside that profile;
+    * larger command streams still grow normally rather than being truncated.
+    * Smaller parcels do not relax the host's byte/span or RM accept guards.
+    */
+   const char *policy = getenv("GB_VENUS_COMMAND_POOL_V1");
+   return policy && !strcmp(policy, "1m") ? (1u << 20) : (8u << 20);
+}
