+/* Process-only profile for the independently qualified Android image bridge.
+ * The controller must verify the pinned host renderer before enabling this.
+ * This is not generic virgl modifier discovery or nonlinear support. */
+static bool
+gb_virgl_linear_profile_enabled(void)
+{
+   const char *value = getenv("GB_VIRGL_ANDROID_LINEAR_V1");
+   return value && !strcmp(value, "qualified-linear-rgbx-v1");
+}
+
+static bool
+gb_virgl_linear_format(enum pipe_format format)
+{
+   return format == PIPE_FORMAT_R8G8B8A8_UNORM ||
+          format == PIPE_FORMAT_B8G8R8A8_UNORM ||
+          format == PIPE_FORMAT_R8G8B8X8_UNORM ||
+          format == PIPE_FORMAT_B8G8R8X8_UNORM;
+}
+
+static void
+gb_virgl_query_dmabuf_modifiers(struct pipe_screen *pscreen,
+                               enum pipe_format format, int max,
+                               uint64_t *modifiers,
+                               unsigned int *external_only, int *count)
+{
+   if (!count)
+      return;
+   *count = 0;
+   if (!virgl_screen(pscreen)->gb_android_linear_import || max < 0 ||
+       !gb_virgl_linear_format(format) ||
+       !pscreen->is_format_supported(pscreen, format, PIPE_TEXTURE_2D, 0, 0,
+                                    PIPE_BIND_SAMPLER_VIEW))
+      return;
+   if (max == 0) {
+      *count = 1;
+      return;
+   }
+   if (!modifiers)
+      return;
+   modifiers[0] = 0; /* DRM_FORMAT_MOD_LINEAR */
+   if (external_only)
+      external_only[0] = false;
+   *count = 1;
+}
+
 static bool
 virgl_is_dmabuf_modifier_supported(UNUSED struct pipe_screen *pscreen,
                                    UNUSED uint64_t modifier,
                                    UNUSED enum pipe_format format,
                                    UNUSED bool *external_only)
 {
+   if (virgl_screen(pscreen)->gb_android_linear_import) {
+      if (modifier != 0 || !gb_virgl_linear_format(format))
+         return false;
+      if (external_only)
+         *external_only = false;
+      return true;
+   }
    /* Always advertise support until virgl starts checking against host
     * virglrenderer or consuming valid non-linear modifiers here.
     */
