+/* GB_WL_EXPLICIT_FEEDBACK_V1_BEGIN
+ * Process-only qualification for the pinned Android LINEAR image bridge.
+ * INVALID remains implicit, never an alias for LINEAR. Allocation and feedback
+ * comparison must use the same effective modifier set.
+ */
+static bool
+gb_wl_explicit_feedback_enabled(void)
+{
+   const char *value = getenv("GB_WSI_EXPLICIT_FEEDBACK_V1");
+   return value && !strcmp(value, "qualified-linear-rgbx-v1");
+}
+
+static bool
+gb_wl_feedback_device_matches(struct wsi_wl_display *display, dev_t device)
+{
+   const struct wsi_device *wsi = display->wsi_wl->wsi;
+   return device != 0 &&
+      ((wsi->drm_info.hasRender &&
+        major(device) == wsi->drm_info.renderMajor &&
+        minor(device) == wsi->drm_info.renderMinor) ||
+       (wsi->drm_info.hasPrimary &&
+        major(device) == wsi->drm_info.primaryMajor &&
+        minor(device) == wsi->drm_info.primaryMinor));
+}
+
+static bool
+gb_wl_explicit_feedback_modifiers(struct wsi_wl_surface *surface,
+                                   VkFormat format, bool alpha,
+                                   uint32_t *count, const uint64_t **modifiers)
+{
+   static const uint64_t linear = DRM_FORMAT_MOD_LINEAR;
+   struct wsi_wl_display *display = surface->display;
+   const uint32_t flag = alpha ? WSI_WL_FMT_ALPHA : WSI_WL_FMT_OPAQUE;
+   *count = 0;
+   *modifiers = NULL;
+   if (!gb_wl_explicit_feedback_enabled() || display->sw || !display->wl_dmabuf ||
+       !display->wsi_wl->wsi->supports_modifiers || !display->same_gpu ||
+       (format != VK_FORMAT_R8G8B8A8_UNORM &&
+        format != VK_FORMAT_B8G8R8A8_UNORM) ||
+       !gb_wl_feedback_device_matches(display, display->main_device))
+      return false;
+
+   /* The initial surface feedback can still be pending. In that case only
+    * the completed, device-qualified default feedback can supply LINEAR. */
+   if (surface->dmabuf_feedback.main_device != 0 &&
+       surface->dmabuf_feedback.main_device != display->main_device)
+      return false;
+
+   /* Surface vectors merge alpha/opaque raw formats under one VkFormat. They
+    * cannot prove that the requested raw fourcc has explicit LINEAR support.
+    * All qualified selections therefore require completed, same-device default
+    * raw-fourcc evidence and select only LINEAR, regardless of that preference.
+    * Never manufacture support from INVALID or choose another modifier. */
+   struct wsi_wl_format *f = find_format(&display->formats, format);
+   const uint8_t bit = gb_wl_linear_format_bit(
+      wl_drm_format_for_vk_format(format, alpha));
+   if (f && (f->flags & flag) && (display->gb_default_linear_formats & bit)) {
+      uint64_t *modifier;
+      u_vector_foreach(modifier, &f->modifiers) {
+         if (*modifier == DRM_FORMAT_MOD_LINEAR) {
+            *count = 1;
+            *modifiers = &linear;
+            return true;
+         }
+      }
+   }
+   return false;
+}
+/* GB_WL_EXPLICIT_FEEDBACK_V1_END */
+
