+/* Four independently qualified explicit LINEAR RGB(A/X) formats only. */
+static uint8_t
+gb_wl_linear_format_bit(uint32_t format)
+{
+   switch (format) {
+   case DRM_FORMAT_ARGB8888: return 1u << 0;
+   case DRM_FORMAT_XRGB8888: return 1u << 1;
+   case DRM_FORMAT_ABGR8888: return 1u << 2;
+   case DRM_FORMAT_XBGR8888: return 1u << 3;
+   default: return 0;
+   }
+}
