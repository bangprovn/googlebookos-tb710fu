+/* GB_NATIVE_WSI_NO_MAP_V1_BEGIN
+ * Only common WSI's private native image allocation may omit the transport's
+ * CPU-mappable capability. Vulkan memory properties and host allocation info
+ * remain unchanged. General application allocations must never enter this path.
+ */
+enum gb_native_wsi_map_policy {
+   GB_NATIVE_WSI_MAP_DEFAULT,
+   GB_NATIVE_WSI_MAP_FORBIDDEN,
+   GB_NATIVE_WSI_MAP_REFUSED,
+};
+
+static enum gb_native_wsi_map_policy
+gb_native_wsi_no_map_policy(struct vn_device *dev,
+                            const VkMemoryAllocateInfo *alloc,
+                            const VkMemoryDedicatedAllocateInfo *dedicated,
+                            bool private_wsi_memory, bool imported)
+{
+   const char *selection = getenv("GB_VENUS_NATIVE_WSI_NO_MAP_V1");
+   if (!selection || strcmp(selection, "private-linear-rgbx-v1") ||
+       !private_wsi_memory)
+      return GB_NATIVE_WSI_MAP_DEFAULT;
+
+   const struct wsi_device *wsi = &dev->physical_device->wsi_device;
+   /* Software/copy and prime-blit storage retain their existing CPU semantics. */
+   if (wsi->sw || (dedicated && dedicated->buffer != VK_NULL_HANDLE))
+      return GB_NATIVE_WSI_MAP_DEFAULT;
+   const struct vn_image *image = dedicated && dedicated->image != VK_NULL_HANDLE
+      ? vn_image_from_handle(dedicated->image) : NULL;
+   if (image && image->wsi.is_prime_blit_src)
+      return GB_NATIVE_WSI_MAP_DEFAULT;
+
+   const char *feedback = getenv("GB_WSI_EXPLICIT_FEEDBACK_V1");
+   if (!feedback || strcmp(feedback, "qualified-linear-rgbx-v1") ||
+       !wsi->supports_modifiers || dev->renderer->info.has_guest_vram ||
+       imported || !image || !image->wsi.is_wsi ||
+       !image->wsi.gb_internal_created || image->wsi.memory ||
+       dedicated->buffer != VK_NULL_HANDLE ||
+       image->wsi.tiling_override != VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ||
+       image->wsi.drm_format_modifier != DRM_FORMAT_MOD_LINEAR ||
+       (image->base.base.format != VK_FORMAT_R8G8B8A8_UNORM &&
+        image->base.base.format != VK_FORMAT_B8G8R8A8_UNORM) ||
+       image->base.base.image_type != VK_IMAGE_TYPE_2D ||
+       image->base.base.extent.depth != 1 ||
+       !image->base.base.extent.width || !image->base.base.extent.height ||
+       image->base.base.extent.width > 8192 || image->base.base.extent.height > 8192 ||
+       (uint64_t)image->base.base.extent.width * image->base.base.extent.height * 4 > 33554432 ||
+       image->base.base.mip_levels != 1 || image->base.base.array_layers != 1 ||
+       image->base.base.samples != VK_SAMPLE_COUNT_1_BIT ||
+       (image->base.base.create_flags & ~VK_IMAGE_CREATE_ALIAS_BIT) ||
+       image->base.base.external_handle_types != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT ||
+       dev->physical_device->external_memory.renderer_handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT ||
+       !alloc->allocationSize || alloc->allocationSize > 33554432)
+      return GB_NATIVE_WSI_MAP_REFUSED;
+
+   const VkExportMemoryAllocateInfo *export_info =
+      vk_find_struct_const(alloc->pNext, EXPORT_MEMORY_ALLOCATE_INFO);
+   if (!export_info || export_info->handleTypes != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT)
+      return GB_NATIVE_WSI_MAP_REFUSED;
+
+   return GB_NATIVE_WSI_MAP_FORBIDDEN;
+}
