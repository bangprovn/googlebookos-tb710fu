 #include <uapi/linux/gunyah.h>
 
 #include "vm_mgr.h"
+
+/* Normalize only the known Android pVM PCI window before any memory is lent.
+ * No guest payload, authentication, firmware partition or runtime key changes.
+ * Parse a bounded private snapshot; never parse guest-writable memory in place.
+ */
+int gh_vm_mem_fixup_pci_ranges(struct gh_vm *ghvm)
+{
+	struct gh_vm_mem *mapping;
+	void *mapped = NULL, *copy = NULL;
+	u64 start = ghvm->dtb_config.guest_phys_addr, offset, capacity;
+	size_t bytes = ghvm->dtb_config.size, skew, count, first;
+	int ret = -EINVAL;
+	size_t i;
+
+	if (ghvm->auth != GH_RM_VM_AUTH_QCOM_ANDROID_PVM)
+		return 0;
+	if (!bytes || bytes > 2 * 1024 * 1024)
+		return -EINVAL;
+
+	mutex_lock(&ghvm->mm_lock);
+	list_for_each_entry(mapping, &ghvm->memory_mappings, list) {
+		capacity = (u64)mapping->npages << PAGE_SHIFT;
+		if (start < mapping->guest_phys_addr)
+			continue;
+		offset = start - mapping->guest_phys_addr;
+		if (offset >= capacity || bytes > capacity - offset)
+			continue;
+		if (!mapping->pages || !mapping->parcel.n_acl_entries ||
+		    !(mapping->parcel.acl_entries[0].perms & GH_RM_ACL_W)) {
+			ret = -EACCES;
+			break;
+		}
+		first = offset >> PAGE_SHIFT;
+		skew = offset & (PAGE_SIZE - 1);
+		count = DIV_ROUND_UP(skew + bytes, PAGE_SIZE);
+		mapped = vmap(mapping->pages + first, count, VM_MAP, PAGE_KERNEL);
+		if (!mapped) {
+			ret = -ENOMEM;
+			break;
+		}
+		copy = kvmalloc(bytes, GFP_KERNEL);
+		if (!copy) {
+			ret = -ENOMEM;
+			break;
+		}
+		memcpy(copy, mapped + skew, bytes);
+		ret = gb_gunyah_normalize_pci_dtb(copy, bytes);
+		if (ret == 1) {
+			memcpy(mapped + skew, copy, bytes);
+			for (i = 0; i < count; i++)
+				flush_dcache_page(mapping->pages[first + i]);
+			pr_info("gb-pci-compat-v1: normalized known Android pVM PCI range type\n");
+			ret = 0;
+		}
+		break;
+	}
+	kvfree(copy);
+	if (mapped)
+		vunmap(mapped);
+	mutex_unlock(&ghvm->mm_lock);
+	return ret;
+}
 
