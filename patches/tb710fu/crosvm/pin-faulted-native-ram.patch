+/// Optional bounded owner coordination. The stage is explicit so the host
+/// cannot confuse allocation-first and pin-fault-first experiments.
+pub fn coordinate_owner(size: u64, phase: &str) -> std::io::Result<()> {
+    if let Some(raw) = std::env::var_os("DROIDVM_PREPIN_PIPE_FD") {
+        let fd = raw.to_str().and_then(|s| s.parse::<i32>().ok());
+        return if size == (2042u64 << 20) {
+            match fd {
+                Some(fd) => {
+                    // SAFETY: geteuid takes no arguments and has no memory side effects.
+                    let uid = unsafe { libc::geteuid() };
+                    prepin_pipe::coordinate(fd, uid, size, std::time::Duration::from_secs(30), |nonce| {
+                        info!("GH-PREPIN2: ready nonce={} bytes={} stage={}", nonce, size, phase);
+                    })
+                }
+                None => Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "invalid inherited gate descriptor")),
+            }
+        } else {
+            Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "invalid diagnostic memory scope"))
+        };
+    }
+    Ok(())
+}
