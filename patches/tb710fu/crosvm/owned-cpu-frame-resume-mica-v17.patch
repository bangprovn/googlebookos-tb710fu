+                .format = kFormat,
+                .bits = const_cast<uint32_t*>(pixels),
+        };
+        if (frameHashEnabled()) logFrameHash(mName, source);
+        auto copied = copyBuffer(source, destination);
+        // Always release the native-window borrow, including copy failures.
+        const int posted = ANativeWindow_unlockAndPost(anw);
