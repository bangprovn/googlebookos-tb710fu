+/* GB_GPU_IDLE_COUNTERS_BEGIN
+ * Process-opt-in event-loop observations only: no scheduling/fence policy.
+ * Fixed records and scalar fields; elapsed durations are wall time, not CPU time.
+ */
+static GB_GPU_IDLE_RECORDS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+const GB_GPU_IDLE_MAX_RECORDS: u32 = 16;
+const GB_GPU_IDLE_INTERVAL_NS: u64 = 5_000_000_000;
+
+struct GpuIdleCounters {
+    started: std::time::Instant,
+    last_record_ns: u64,
+    waits: u64,
+    empty_waits: u64,
+    quick_waits: u64,
+    wait_ns: u64,
+    work_ns: u64,
+    readable: [u64; 10],
+    ctrl_progress_batches: u64,
+    cursor_progress_batches: u64,
+    flip_pending_peak: u64,
+    flip_retired: u64,
+}
+
+impl GpuIdleCounters {
+    fn new(selection: Option<&str>) -> Option<Self> {
+        if selection != Some("worker-counters-v1")
+            || GB_GPU_IDLE_RECORDS.load(Ordering::Relaxed) >= GB_GPU_IDLE_MAX_RECORDS
+        {
+            return None;
+        }
+        Some(Self {
+            started: std::time::Instant::now(),
+            last_record_ns: 0,
+            waits: 0,
+            empty_waits: 0,
+            quick_waits: 0,
+            wait_ns: 0,
+            work_ns: 0,
+            readable: [0; 10],
+            ctrl_progress_batches: 0,
+            cursor_progress_batches: 0,
+            flip_pending_peak: 0,
+            flip_retired: 0,
+        })
+    }
+
+    fn nanos(duration: Duration) -> u64 {
+        duration.as_nanos().min(u64::MAX as u128) as u64
+    }
+
+    fn wait_completed(&mut self, duration: Duration, empty: bool) {
+        let ns = Self::nanos(duration);
+        self.waits = self.waits.saturating_add(1);
+        self.empty_waits = self.empty_waits.saturating_add(u64::from(empty));
+        self.quick_waits = self.quick_waits.saturating_add(u64::from(ns <= 100_000));
+        self.wait_ns = self.wait_ns.saturating_add(ns);
+    }
+
+    fn readable_event(&mut self, token: WorkerToken) {
+        let index = match token {
+            WorkerToken::CtrlQueue => 0,
+            WorkerToken::CursorQueue => 1,
+            WorkerToken::Display => 2,
+            WorkerToken::GpuControl => 3,
+            WorkerToken::ResourceBridge { .. } => 4,
+            WorkerToken::VirtioGpuPoll => 5,
+            WorkerToken::FlipFence => 6,
+            WorkerToken::Sleep => 7,
+            WorkerToken::Kill => 8,
+            #[cfg(windows)]
+            WorkerToken::DisplayDescriptorRequest => 9,
+        };
+        self.readable[index] = self.readable[index].saturating_add(1);
+    }
+
+    fn queue_progress(&mut self, cursor: bool) {
+        let value = if cursor {
+            &mut self.cursor_progress_batches
+        } else {
+            &mut self.ctrl_progress_batches
+        };
+        *value = value.saturating_add(1);
+    }
+
+    fn flip_sweep(&mut self, before: usize, after: usize) {
+        self.flip_pending_peak = self.flip_pending_peak.max(before as u64);
+        self.flip_retired = self.flip_retired.saturating_add(before.saturating_sub(after) as u64);
+    }
+
+    fn record(&mut self, elapsed: Duration, work: Duration, final_record: bool) -> Option<String> {
+        self.work_ns = self.work_ns.saturating_add(Self::nanos(work));
+        let elapsed_ns = Self::nanos(elapsed);
+        if !final_record && elapsed_ns.saturating_sub(self.last_record_ns) < GB_GPU_IDLE_INTERVAL_NS {
+            return None;
+        }
+        // One process-wide budget, including worker recreation and concurrent devices.
+        let ordinal = GB_GPU_IDLE_RECORDS.fetch_update(
+            Ordering::Relaxed,
+            Ordering::Relaxed,
+            |count| (count < GB_GPU_IDLE_MAX_RECORDS).then(|| count + 1),
+        ).ok()?;
+        self.last_record_ns = elapsed_ns;
+        Some(format!(
+            "GB-GPU-IDLE-TRACE:{{\"schema_version\":1,\"scope\":\"worker_event_counters\",\"record\":{},\"final_record\":{},\"elapsed_ms\":{},\"waits\":{},\"empty_waits\":{},\"quick_waits_le_100us\":{},\"wait_ns\":{},\"work_ns\":{},\"readable_tokens\":{{\"ctrl_queue\":{},\"cursor_queue\":{},\"display\":{},\"gpu_control\":{},\"resource_bridge\":{},\"virtio_gpu_poll\":{},\"flip_fence\":{},\"sleep\":{},\"kill\":{},\"display_descriptor_request\":{}}},\"queue_progress_batches\":{{\"ctrl\":{},\"cursor\":{}}},\"flip_pending_peak\":{},\"flip_retired\":{},\"cpu_usage_measured\":false}}",
+            ordinal + 1, final_record, elapsed_ns / 1_000_000,
+            self.waits, self.empty_waits, self.quick_waits, self.wait_ns, self.work_ns,
+            self.readable[0], self.readable[1], self.readable[2], self.readable[3],
+            self.readable[4], self.readable[5], self.readable[6], self.readable[7],
+            self.readable[8], self.readable[9], self.ctrl_progress_batches,
+            self.cursor_progress_batches, self.flip_pending_peak, self.flip_retired,
+        ))
+    }
+}
+
+fn gpu_idle_checkpoint(
+    trace: &mut Option<GpuIdleCounters>,
+    work_started: Option<std::time::Instant>,
+    final_record: bool,
+) {
+    if trace.is_none() {
+        return;
+    }
+    if let (Some(trace), Some(work_started)) = (trace.as_mut(), work_started) {
+        let now = std::time::Instant::now();
+        if let Some(line) = trace.record(
+            now.saturating_duration_since(trace.started),
+            now.saturating_duration_since(work_started),
+            final_record,
+        ) {
+            info!("{}", line);
+        }
+    }
+    // Stop collecting after the shared cap, including clocks on later iterations.
+    if GB_GPU_IDLE_RECORDS.load(Ordering::Relaxed) >= GB_GPU_IDLE_MAX_RECORDS {
+        *trace = None;
+    }
+}
