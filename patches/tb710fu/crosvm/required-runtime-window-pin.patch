+    /// Mandatory whole-window pin. Absence of the optional probe or io_uring is
+    /// not evidence of pinnability. Do not accept environment opt-outs here.
+    /// The caller retains the pin for the VM lifetime, before firmware sharing.
+    pub fn pin_required(host_addr: u64, size: u64, site: PinSite) -> Result<LongtermPin> {
+        if size == 0 || size > (2u64 << 30) || host_addr.checked_add(size).is_none() {
+            return Err(Error::new(libc::EINVAL));
+        }
+        if fail_injected(site) {
+            return Err(Error::new(libc::ENOMEM));
+        }
+        info!("GH-PIN: required whole-window pin begin ({} MiB)", size >> 20);
+        match Self::pin(host_addr, size, site)? {
+            Some(pin) => {
+                info!("GH-PIN: required whole-window pin held ({} MiB)", size >> 20);
+                Ok(pin)
+            }
+            None => {
+                error!("GH-PIN: required whole-window pin unavailable; refusing before firmware sharing");
+                Err(Error::new(libc::ENOTSUP))
+            }
+        }
+    }
+
