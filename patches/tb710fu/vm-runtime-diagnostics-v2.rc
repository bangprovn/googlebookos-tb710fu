# V2 opens a dedicated read-only kmsg descriptor in init. The collector seeks
# its private cursor to end and marks it nonblocking/CLOEXEC. Device mode,
# global kernel log cursors, guest authentication and capabilities stay intact.
on property:debug.gb.vm_capture=1
    setprop debug.gb.vm_capture 0
    start gb-vm-logger

on property:debug.gb.vm_probe_protected=1
    setprop debug.gb.vm_probe_protected 0
    setprop ro.boot.hypervisor.protected_vm.supported 1

service gb-vm-logger /system_ext/bin/gb-boot-logger --vm-service
    class core
    user root
    group root log readproc
    capabilities SYSLOG
    file /dev/kmsg r
    disabled
    oneshot
