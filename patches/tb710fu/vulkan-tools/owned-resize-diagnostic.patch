+#if defined(VK_USE_PLATFORM_WAYLAND_KHR)
+/* GB_OWNED_RESIZE_HELPERS_BEGIN
+ * Diagnostic only; preserves the upstream rendering/presentation path.
+ * The pure helpers are also compiled independently by the host bounds test. */
+struct gb_owned_resize_state {
+    unsigned request, configure_count, recreations, samples_emitted;
+    bool maximized_seen, restored_seen, maximized_recreated, restored_recreated, currently_maximized;
+    int32_t width, height, maximized_width, maximized_height;
+};
+static bool gb_owned_resize_enabled(void) {
+    const char *selection = getenv("GB_VKCUBE_OWNED_RESIZE_V1");
+    return selection && !strcmp(selection, "owned-maximize-v1");
+}
+static bool gb_owned_resize_extent(int32_t width, int32_t height) {
+    return width >= 32 && height >= 32 && width <= 3200 && height <= 2000 &&
+           (uint64_t)width * (uint64_t)height * 4 <= 33554432ULL;
+}
+static bool gb_owned_resize_configure(struct gb_owned_resize_state *s, int32_t width, int32_t height, bool maximized) {
+    if (width < 0 || height < 0 || s->configure_count >= 64) return false;
+    /* The compositor may leave unmaximized sizing to the client. */
+    if (!width) width = s->request == 2 && !maximized ? 640 : s->width;
+    if (!height) height = s->request == 2 && !maximized ? 480 : s->height;
+    if (!gb_owned_resize_extent(width, height)) return false;
+    s->width = width; s->height = height; s->configure_count++; s->currently_maximized = maximized;
+    if (s->request == 1 && maximized && (width != 640 || height != 480)) {
+        s->maximized_seen = true; s->maximized_width = width; s->maximized_height = height;
+    }
+    if (s->request == 2 && !maximized && width == 640 && height == 480) s->restored_seen = true;
+    return true;
+}
+static bool gb_owned_resize_recreated(struct gb_owned_resize_state *s, bool old_swapchain,
+                                      int32_t width, int32_t height, uint32_t images) {
+    if (!images || images > 4 || !gb_owned_resize_extent(width, height)) return false;
+    if (!old_swapchain) return true;
+    if (s->recreations >= 16) return false;
+    s->recreations++;
+    if (s->request == 1 && s->maximized_seen && width == s->maximized_width && height == s->maximized_height)
+        s->maximized_recreated = true;
+    if (s->request == 2 && s->restored_seen && width == 640 && height == 480) s->restored_recreated = true;
+    return true;
+}
+/* Return one-shot request, no action, or refusal. Configuration/recreation
+ * must complete before the next request, not merely before process exit. */
+static int gb_owned_resize_action(struct gb_owned_resize_state *s, int32_t frame) {
+    if (frame == 400) {
+        if (s->request) return -1;
+        s->request = 1; return 1;
+    }
+    if (frame == 800 && (!s->maximized_seen || !s->maximized_recreated)) return -1;
+    if (frame == 1400) {
+        if (s->request != 1 || !s->maximized_seen || !s->maximized_recreated) return -1;
+        s->request = 2; return 2;
+    }
+    if (frame == 1800 && (!s->restored_seen || !s->restored_recreated)) return -1;
+    return 0;
+}
+static bool gb_owned_resize_completed(const struct gb_owned_resize_state *s) {
+    return s->request == 2 && s->maximized_seen && s->restored_seen &&
+           s->maximized_recreated && s->restored_recreated;
+}
+/* Six one-shot observer markers; no sleeping, input or synchronization with
+ * the observer. A missing scheduled frame refuses rather than reusing a slot. */
+static int gb_owned_resize_sample(struct gb_owned_resize_state *s, int32_t frame) {
+    static const int32_t frames[6] = {100,250,900,1150,1900,2150};
+    if (s->samples_emitted >= 6) return -1;
+    if (frame < frames[s->samples_emitted]) return -1;
+    if (frame > frames[s->samples_emitted]) return -2;
+    return (int)s->samples_emitted++;
+}
+/* GB_OWNED_RESIZE_HELPERS_END */
+static void gb_owned_resize_refuse(const char *stage) {
+    printf("GB_OWNED_RESIZE:{\"schema_version\":1,\"status\":\"refused\",\"stage\":\"%s\",\"presentation_verified\":false}\n", stage);
+    fflush(stdout); exit(2);
+}
+#endif
