+/* GB_OWNED_FIXED_API_HELPER_BEGIN
+ * Diagnostic metadata only. Do not retry or change allocation policy; fail
+ * before the upstream assertion while preserving its behavior in other modes. */
+static void gb_owned_fixed_texture_api_error(struct demo *demo, const struct texture_object *tex_obj,
+                                             const char *api, int32_t result, uint32_t required_props,
+                                             uint32_t memory_type_bits) {
+    if (!gb_owned_fixed_enabled() || result == 0) return;
+    uint32_t index = tex_obj->mem_alloc.memoryTypeIndex;
+    bool known = index < demo->memory_properties.memoryTypeCount && index < VK_MAX_MEMORY_TYPES;
+    uint32_t flags = known ? demo->memory_properties.memoryTypes[index].propertyFlags : 0;
+    fprintf(stderr, "GB_OWNED_FIXED_API_ERROR:{\"schema_version\":1,\"api\":\"%s\",\"vk_result\":%" PRId32
+            ",\"frame\":%d,\"allocation_bytes\":%" PRIu64 ",\"memory_type_index\":%" PRIu32
+            ",\"memory_type_bits\":%" PRIu32 ",\"required_property_flags\":%" PRIu32
+            ",\"memory_properties_known\":%s,\"memory_property_flags\":%" PRIu32
+            ",\"host_coherent\":%s,\"presentation_verified\":false}\n",
+            api, result, demo->curFrame, (uint64_t)tex_obj->mem_alloc.allocationSize, index,
+            memory_type_bits, required_props, known ? "true" : "false", flags,
+            known && (flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) ? "true" : "false");
+    fflush(stderr);
+    gb_owned_resize_refuse("texture_image_api_failure");
+}
+/* GB_OWNED_FIXED_API_HELPER_END */
+#endif
