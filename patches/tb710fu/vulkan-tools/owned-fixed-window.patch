+static bool gb_owned_fixed_enabled(void) {
+    const char *selection = getenv("GB_VKCUBE_OWNED_FIXED_V1");
+    return selection && !strcmp(selection, "owned-fixed-v1");
+}
+static bool gb_owned_window_enabled(void) {
+    return gb_owned_resize_enabled() || gb_owned_fixed_enabled();
+}
@@ -421,0 +429,16 @@
+}
+static bool gb_owned_window_extent(int32_t width, int32_t height) {
+    return gb_owned_fixed_enabled() ? width == 640 && height == 480 : gb_owned_resize_extent(width, height);
+}
+static bool gb_owned_window_arguments(bool wayland, int32_t width, int32_t height, int32_t frames) {
+    if (gb_owned_resize_enabled() && gb_owned_fixed_enabled()) return false;
+    if (!wayland || width != 640 || height != 480) return false;
+    return gb_owned_fixed_enabled() ? frames >= 2400 && frames <= 3600 : frames >= 2200 && frames <= 2400;
+}
+static bool gb_owned_fixed_configure(struct gb_owned_resize_state *s, int32_t width, int32_t height, bool maximized) {
+    if (maximized || width < 0 || height < 0 || s->configure_count >= 64) return false;
+    if (!width) width = 640;
+    if (!height) height = 480;
+    if (width != 640 || height != 480) return false;
+    s->width = width; s->height = height; s->configure_count++; s->currently_maximized = false;
+    return true;
