@@ -255,6 +255,35 @@
 
 #endif /* ENABLE_GBM_ALLOCATION */
 
+static bool
+vkr_allocation_trace_allowed(void)
+{
+   const char *policy = getenv("GB_VENUS_ALLOCATION_DIAGNOSTICS_V1");
+   if (!policy || strcmp(policy, "1"))
+      return false;
+   static unsigned count;
+   unsigned seen = __atomic_load_n(&count, __ATOMIC_RELAXED);
+   while (seen < 16) {
+      if (__atomic_compare_exchange_n(&count, &seen, seen + 1, false,
+                                       __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+         return true;
+   }
+   return false;
+}
+
+static void
+vkr_discard_allocation_backing(int import_fd, int udmabuf_fd, void *gbm_bo,
+                                struct vkr_mtl_shm *mtl_shm)
+{
+   if (import_fd >= 0)
+      close(import_fd);
+   if (udmabuf_fd >= 0 && udmabuf_fd != import_fd)
+      close(udmabuf_fd);
+   if (gbm_bo)
+      vkr_gbm_bo_destroy(gbm_bo);
+   vkr_mtl_shm_free(mtl_shm);
+}
