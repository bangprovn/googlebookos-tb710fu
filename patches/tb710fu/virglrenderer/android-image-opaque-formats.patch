+/* Explicit opaque formats retain RGBX sampling semantics, never source alpha.
+ * No implicit modifier is accepted. GB_IMAGE_OPAQUE_FORMATS is a test marker. */
+#define GB_IMAGE_OPAQUE_FORMATS 1
+static bool gb_image_format(uint32_t fourcc, bool *blit, uint32_t *ahb_format)
+{
+   bool bgra, opaque;
+   switch (fourcc) {
+   case 0x34324241u: bgra=false; opaque=false; break; /* ABGR8888 */
+   case 0x34325241u: bgra=true; opaque=false; break;  /* ARGB8888 */
+   case 0x34324258u: bgra=false; opaque=true; break;  /* XBGR8888 */
+   case 0x34325258u: bgra=true; opaque=true; break;   /* XRGB8888 */
+   default: return false;
+   }
+   if (blit) *blit=bgra;
+   /* Android R8G8B8A8_UNORM=1; R8G8B8X8_UNORM=2. Both use Vulkan RGBA8. */
+   if (ahb_format) *ahb_format=opaque?2u:1u;
+   return true;
+}
