+/* Native release drivers report allocation failures through debug utils. Only
+ * these fixed allocation diagnostics are useful here: never log arbitrary guest
+ * debug messages, object names or application strings. One message per operation
+ * per process bounds repeated failures; the atomic bitmask cannot wrap.
+ */
+static VkBool32
+vkr_allocation_callback(UNUSED VkDebugUtilsMessageSeverityFlagBitsEXT severity,
+                        UNUSED VkDebugUtilsMessageTypeFlagsEXT types,
+                        const VkDebugUtilsMessengerCallbackDataEXT *data,
+                        UNUSED void *user)
+{
+   static unsigned logged_operations;
+   if (!data || !data->pMessage)
+      return VK_FALSE;
+
+   const char *operation;
+   unsigned bit;
+   if (!strncmp(data->pMessage, "Failed to import dma-buf (",
+                sizeof("Failed to import dma-buf (") - 1)) {
+      operation = "import_dmabuf";
+      bit = 1;
+   } else if (!strncmp(data->pMessage, "Failed to get dma-buf info (",
+                       sizeof("Failed to get dma-buf info (") - 1)) {
+      operation = "get_dmabuf_info";
+      bit = 2;
+   } else {
+      return VK_FALSE;
+   }
+   if (!(__atomic_fetch_or(&logged_operations, bit, __ATOMIC_RELAXED) & bit)) {
+      const char *error = "unclassified";
+      const struct { const char *text; const char *name; } errors[] = {
+         {"(Invalid argument)", "invalid_argument"},
+         {"(Permission denied)", "permission_denied"},
+         {"(Operation not permitted)", "operation_not_permitted"},
+         {"(Cannot allocate memory)", "no_memory"},
+         {"(Out of memory)", "no_memory"},
+         {"(Bad address)", "bad_address"},
+         {"(Bad file descriptor)", "bad_fd"},
+         {"(No such device)", "no_device"},
+         {"(Operation not supported)", "not_supported"},
+         {"(Device or resource busy)", "busy"},
+         {"(Too many open files)", "too_many_files"},
+         {"(Input/output error)", "io_error"},
+      };
+      for (unsigned i = 0; i < ARRAY_SIZE(errors); i++) {
+         if (strstr(data->pMessage, errors[i].text)) {
+            error = errors[i].name;
+            break;
+         }
+      }
+      vkr_log("GB-VENUS-ALLOC: driver_operation=%s errno_class=%s", operation, error);
+   }
+   return VK_FALSE;
+}
