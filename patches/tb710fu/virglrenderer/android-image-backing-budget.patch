+/* Pair slot and backing admission. No driver, FD, logging or destructor call
+ * is made while this short accounting lock is held. Unknown AHB storage is
+ * provisionally charged at its existing per-image maximum before allocation.
+ * This bounds accounted backing, not driver/object overhead or an oversized
+ * rejected AHB's transient allocation, whose size is learned after allocation.
+ */
+static pthread_mutex_t gb_image_budget_lock=PTHREAD_MUTEX_INITIALIZER;
+static uint64_t gb_image_backing_bytes;
+enum gb_image_budget_result { GB_IMAGE_BUDGET_OK, GB_IMAGE_BUDGET_SLOTS, GB_IMAGE_BUDGET_BYTES };
+static enum gb_image_budget_result gb_image_budget_acquire(uint64_t bytes)
+{
+   enum gb_image_budget_result result=GB_IMAGE_BUDGET_OK;
+   pthread_mutex_lock(&gb_image_budget_lock);
+   if (atomic_load(&gb_image_slots)>=GB_IMAGE_SLOTS) result=GB_IMAGE_BUDGET_SLOTS;
+   else if (!bytes || bytes>GB_IMAGE_BACKING_LIMIT-gb_image_backing_bytes) result=GB_IMAGE_BUDGET_BYTES;
+   else {atomic_fetch_add(&gb_image_slots,1);gb_image_backing_bytes+=bytes;}
+   pthread_mutex_unlock(&gb_image_budget_lock);
+   return result;
+}
+static bool gb_image_budget_shrink(uint64_t old_bytes,uint64_t new_bytes)
+{
+   bool valid;
+   pthread_mutex_lock(&gb_image_budget_lock);
+   valid=new_bytes && new_bytes<=old_bytes && old_bytes<=gb_image_backing_bytes;
+   if (valid) gb_image_backing_bytes-=old_bytes-new_bytes;
+   pthread_mutex_unlock(&gb_image_budget_lock);
+   return valid;
+}
+static bool gb_image_budget_release(uint64_t bytes)
+{
+   bool valid;
+   pthread_mutex_lock(&gb_image_budget_lock);
+   valid=bytes && bytes<=gb_image_backing_bytes && atomic_load(&gb_image_slots)>0;
+   if (valid) {gb_image_backing_bytes-=bytes;atomic_fetch_sub(&gb_image_slots,1);}
+   pthread_mutex_unlock(&gb_image_budget_lock);
+   return valid;
+}
+static void gb_image_budget_snapshot(unsigned *slots,uint64_t *bytes)
+{
+   pthread_mutex_lock(&gb_image_budget_lock);
+   *slots=atomic_load(&gb_image_slots);*bytes=gb_image_backing_bytes;
+   pthread_mutex_unlock(&gb_image_budget_lock);
+}
