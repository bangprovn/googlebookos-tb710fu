+   pthread_mutex_lock(&gb_image_registry_lock);
+   for (unsigned i=0;i<GB_IMAGE_SLOTS;i++) if (gb_image_registry[i].owner==GB_IMAGE_FREE) {
+      gb_image_registry[i]=(struct gb_image_entry){g,GB_IMAGE_ACTIVE};found=true;break;
