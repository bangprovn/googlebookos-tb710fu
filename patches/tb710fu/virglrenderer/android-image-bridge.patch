+bool virgl_egl_android_bridge_required(struct virgl_egl *egl)
+{
+#if defined(__ANDROID__) && defined(__aarch64__) && defined(ENABLE_VULKAN_DLOAD)
+   const char *mode=getenv("GB_ANDROID_IMAGE_BRIDGE_V1");
+   if (!mode || strcmp(mode,"diagnostic-linear-v1") || !egl) return false;
+   gb_image_log("egl_dma_buf_import_advertised",has_bit(egl->extension_bits,EGL_EXT_IMAGE_DMA_BUF_IMPORT),0,0);
+   return !has_bit(egl->extension_bits,EGL_EXT_IMAGE_DMA_BUF_IMPORT);
+#else
+   (void)egl; return false;
+#endif
+}
+
+void *virgl_egl_image_from_android_bridge(struct virgl_egl *egl,
+   uint32_t width, uint32_t height, uint32_t format, uint64_t modifier,
+   uint32_t planes, int fd, uint32_t stride, uint32_t offset, void **bridge)
+{
+   *bridge=NULL;
+#if defined(__ANDROID__) && defined(__aarch64__) && defined(ENABLE_VULKAN_DLOAD)
+   const char *extensions=eglQueryString(egl->egl_display,EGL_EXTENSIONS);
+   if (!virgl_egl_has_extension_in_string(extensions,"EGL_ANDROID_image_native_buffer") ||
+       !virgl_egl_has_extension_in_string(extensions,"EGL_ANDROID_get_native_client_buffer") ||
+       !virgl_has_egl_khr_gl_colorspace(egl)) return NULL;
+   struct gb_android_image *g=gb_android_image_create(width,height,format,modifier,planes,fd,stride,offset);
+   if (!g) return NULL;
+   glFinish();
+   if (!gb_android_image_refresh(g)) {gb_android_image_destroy(g);return NULL;}
+   PFNEGLGETNATIVECLIENTBUFFERANDROIDPROC native=(PFNEGLGETNATIVECLIENTBUFFERANDROIDPROC)eglGetProcAddress("eglGetNativeClientBufferANDROID");
+   const EGLint attrs[]={EGL_IMAGE_PRESERVED_KHR,EGL_TRUE,EGL_GL_COLORSPACE_KHR,EGL_GL_COLORSPACE_LINEAR_KHR,EGL_NONE};
+   EGLImageKHR image=EGL_NO_IMAGE_KHR;
+   if (native) image=eglCreateImageKHR(egl->egl_display,EGL_NO_CONTEXT,EGL_NATIVE_BUFFER_ANDROID,native(g->ahb),attrs);
+   if (image==EGL_NO_IMAGE_KHR) {gb_image_log("native_egl_image",eglGetError(),width,height);gb_android_image_destroy(g);return NULL;}
+   *bridge=g;return image;
+#else
+   (void)egl;(void)width;(void)height;(void)format;(void)modifier;(void)planes;(void)fd;(void)stride;(void)offset;return NULL;
+#endif
+}
+
+bool virgl_egl_android_bridge_refresh(void *bridge)
+{
+#if defined(__ANDROID__) && defined(__aarch64__) && defined(ENABLE_VULKAN_DLOAD)
+   glFinish();return gb_android_image_refresh(bridge);
+#else
+   (void)bridge;return false;
+#endif
+}
+
+void virgl_egl_android_bridge_destroy(void *bridge)
+{
+#if defined(__ANDROID__) && defined(__aarch64__) && defined(ENABLE_VULKAN_DLOAD)
