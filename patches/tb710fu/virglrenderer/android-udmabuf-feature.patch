+#if defined(__ANDROID__) && defined(__linux__) && __has_include(<linux/udmabuf.h>)
+#define HAVE_LINUX_UDMABUF_H 1
+#endif
 #define HAVE_STRTOK_R 1
 #define HAVE_TIMESPEC_GET 1
 #define HAVE_SYS_UIO_H 1
