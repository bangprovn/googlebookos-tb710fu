+/* Failure-only diagnostics are independent of the original success/layout
+ * budget. ACTIVE calls retain their single GL-owner/reference contract.
+ * Counters are atomic, but a snapshot across counters is observational rather
+ * than transactional. Charged slots include allocation reservations; active
+ * counts allocated nonquarantined objects, including construction in progress.
+ * Quarantine here records D91's existing retention; this is not a reaper.
+ */
+static struct {
+   atomic_uint active, pending, quarantined, allocated, created, freed, slot_refused;
+   atomic_uint create_failed, refresh_ok, refresh_failed, refresh_skipped, reports;
+} gb_image_diag;
+static void gb_image_diag_increment(atomic_uint *counter)
+{
+   unsigned value=atomic_load_explicit(counter,memory_order_relaxed);
+   while (value!=UINT32_MAX && !atomic_compare_exchange_weak_explicit(
+      counter,&value,value+1,memory_order_relaxed,memory_order_relaxed)) {}
+}
