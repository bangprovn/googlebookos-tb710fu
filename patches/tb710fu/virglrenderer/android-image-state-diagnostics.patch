+      event,stage,result,vk_result_valid?"true":"false",width,height,
+      atomic_load(&gb_image_slots),atomic_load(&gb_image_diag.active),atomic_load(&gb_image_diag.pending),
+      atomic_load(&gb_image_diag.quarantined),atomic_load(&gb_image_diag.allocated),atomic_load(&gb_image_diag.created),atomic_load(&gb_image_diag.freed),
+      atomic_load(&gb_image_diag.slot_refused),atomic_load(&gb_image_diag.create_failed),atomic_load(&gb_image_diag.refresh_ok),
+      atomic_load(&gb_image_diag.refresh_failed),atomic_load(&gb_image_diag.refresh_skipped));
+}
