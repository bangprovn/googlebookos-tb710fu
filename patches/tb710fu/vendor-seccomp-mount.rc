# Exact donor/vendor pairing only. Original read-only vendor partition stays
# intact. The two owner-provided allowlists append only observed lseek support;
# Minijail remains enabled and retains all other filters and argument checks.
on post-fs-data && property:ro.build.fingerprint=Dell/mica/mica:17/CL3B.260622.273.R1/16471258:user/release-keys && property:ro.vendor.build.fingerprint=Lenovo/TB710FU/TB710FU:16/BP2A.250605.031.A3/ZUI_17.5.04.059_260327_ROW:user/release-keys
    mount none /system_ext/gb-vendor-seccomp/qsap_qapeservice.policy /vendor/etc/seccomp_policy/qsap_qapeservice.policy bind
    mount none /system_ext/gb-vendor-seccomp/qesdksec.policy /vendor/etc/seccomp_policy/qesdksec.policy bind
