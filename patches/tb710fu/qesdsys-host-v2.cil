; Candidate: init-managed UID1000 ART host for the unchanged owner-stock APK.
; Policy compilation and physical client qualification are required before use.
(type gb_qesdsys)
(roletype r gb_qesdsys)
(typeattributeset domain (gb_qesdsys))
(typeattributeset coredomain (gb_qesdsys))
(type gb_qesdsys_service)
(roletype object_r gb_qesdsys_service)
(typeattributeset service_manager_type (gb_qesdsys_service))
(type gb_qesdsys_tmpfs)
(roletype object_r gb_qesdsys_tmpfs)
(typeattributeset file_type (gb_qesdsys_tmpfs))
(typeattributeset mlstrustedobject (gb_qesdsys_tmpfs))
(typetransition gb_qesdsys tmpfs file gb_qesdsys_tmpfs)

(allow init gb_qesdsys (process (transition siginh rlimitinh)))
(allow gb_qesdsys init (process (sigchld)))
(allow gb_qesdsys init (fd (use)))
(allow gb_qesdsys self (process (fork sigchld sigkill signal)))
(allow gb_qesdsys zygote_exec (file (read open getattr map execute entrypoint)))
(allow gb_qesdsys system_file (dir (search read open getattr)))
(allow gb_qesdsys system_file (file (read open getattr map execute)))
(allow gb_qesdsys system_lib_file (file (read open getattr map execute)))
(allow gb_qesdsys system_lib_file (dir (search read open getattr)))
(allow gb_qesdsys dalvikcache_data_file (dir (search read open getattr)))
(allow gb_qesdsys dalvikcache_data_file (file (read open getattr map)))
(allow gb_qesdsys apex_art_data_file (dir (search read open getattr)))
(allow gb_qesdsys apex_art_data_file (file (read open getattr map)))
; The private runtime honors interpreter-only flags. No executable writable
; data, executable memfd or process execmem permission is added.
(allow gb_qesdsys gb_qesdsys_tmpfs (file (create read write open getattr map lock setattr)))
(allow gb_qesdsys proc_meminfo (file (read open getattr)))
(allow gb_qesdsys proc_version (file (read open getattr)))
(allow gb_qesdsys proc_pid_max (file (read open getattr)))

; Register the real stock interface; framework operations use system_server.
(allow gb_qesdsys servicemanager (binder (call transfer)))
(allow servicemanager gb_qesdsys (binder (call transfer)))
(allow servicemanager gb_qesdsys (process (getattr)))
(allow gb_qesdsys gb_qesdsys_service (service_manager (add find)))
(allow vendor_hal_qesdhal_default gb_qesdsys_service (service_manager (find)))
(allow shell gb_qesdsys_service (service_manager (find)))
(allow gb_qesdsys system_server (binder (call transfer)))
(allow system_server gb_qesdsys (binder (call transfer)))
(allow gb_qesdsys vendor_hal_qesdhal_default (binder (call transfer)))
(allow vendor_hal_qesdhal_default gb_qesdsys (binder (call transfer)))
(allow gb_qesdsys appops_service (service_manager (find)))
(allow gb_qesdsys location_service (service_manager (find)))
(allow gb_qesdsys user_service (service_manager (find)))
(allow gb_qesdsys display_service (service_manager (find)))
(allow gb_qesdsys graphicsstats_service (service_manager (find)))
(allow gb_qesdsys permission_service (service_manager (find)))
(allow gb_qesdsys activity_service (service_manager (find)))
(allow gb_qesdsys package_service (service_manager (find)))
(allow shell gb_qesdsys (binder (call transfer)))

; Only Android logd IPC; no network, user-data writes or firmware access.
(allow gb_qesdsys logdw_socket (sock_file (write)))
(allow gb_qesdsys logd (unix_dgram_socket (sendto)))
(neverallow gb_qesdsys self (capability (sys_admin sys_boot sys_module sys_ptrace mknod dac_override dac_read_search)))
(neverallow gb_qesdsys self (capability2 (mac_admin mac_override)))
(neverallow gb_qesdsys dev_type (blk_file (read write open append)))
; The platform's inherited coredomain shell/toolbox grant is unchanged. The
; fixed launcher invokes the verified app_process in the same domain. Every
; other file remains covered here; init noatsecure is never granted.
(typeattribute gb_qesdsys_noexec_files)
(typeattributeset gb_qesdsys_noexec_files (and (file_type) (not (shell_exec toolbox_exec zygote_exec))))
(neverallow gb_qesdsys gb_qesdsys_noexec_files (file (execute_no_trans)))

; Signed-image shell launcher initializes private environment after init's
; secure transition. The following same-domain exec needs no noatsecure grant.
(type gb_qesdsys_exec)
(roletype object_r gb_qesdsys_exec)
(typeattributeset file_type (gb_qesdsys_exec))
(typeattributeset exec_type (gb_qesdsys_exec))
(typeattributeset system_file_type (gb_qesdsys_exec))
(allow init gb_qesdsys_exec (file (read open getattr map execute)))
(typetransition init gb_qesdsys_exec process gb_qesdsys)
(allow gb_qesdsys gb_qesdsys_exec (file (read open getattr map execute entrypoint)))
(allow gb_qesdsys zygote_exec (file (execute_no_trans)))
(allow gb_qesdsys permissionmgr_service (service_manager (find)))
