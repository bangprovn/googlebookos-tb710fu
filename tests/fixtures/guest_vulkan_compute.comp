#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Result { uint words[]; } result;
layout(push_constant) uniform Challenge { uint seed; uint cpu_input; } challenge;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 1024) {
        uint value = challenge.cpu_input != 0 ? result.words[i] : i;
        result.words[i] = ((value * 1664525u + challenge.seed) ^ 0xa5c31f07u);
    }
}
