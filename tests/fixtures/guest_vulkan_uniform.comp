#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Result { uint words[]; } result;
layout(set = 0, binding = 1, std140) uniform CPUInput { uvec4 words[256]; } input_data;
layout(push_constant) uniform Challenge { uint seed; uint reserved; } challenge;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 1024) {
        uint value = input_data.words[i / 4][i % 4];
        result.words[i] = ((value * 1664525u + challenge.seed) ^ 0xa5c31f07u);
    }
}
